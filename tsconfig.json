{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@cucumber/cucumber"]
  },
  "include": [
    "features/**/*.ts",
    "hooks/**/*.ts",
    "pages/**/*.ts",
    "steps/**/*.ts",
    "support/**/*.ts",
    "testData/**/*.ts"
  ]
}
